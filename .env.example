PORT=3000

# Local Supabase stack (started via `npm run db:start`, i.e. `supabase start`).
# These values are Supabase CLI's well-known local-dev defaults, printed by
# `supabase status` — safe to commit, not secrets. A real cloud project's
# equivalents (in Supabase dashboard > Settings > API / Database) must NOT
# be committed; keep those only in the untracked .env for staging/prod.
# app_user is a non-superuser, non-BYPASSRLS role created in
# supabase/migrations/20260825093642_add_app_user_role.sql specifically so
# RLS policies are actually enforced for the app's connection (the CLI's
# own `postgres` role has BYPASSRLS and must never be used by the app).
DATABASE_URL=postgresql://app_user:app_user_local_dev@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# When true, POST /properties/:id/publish requires landlord_profiles.verification_status
# = 'verified'. Landlord verification isn't built yet, so leave false locally.
REQUIRE_VERIFICATION=false
